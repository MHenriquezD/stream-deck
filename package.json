{
  "name": "spartan-hub",
  "private": true,
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,WEB\" -c \"blue,green\" \"pnpm --filter server start:dev\" \"pnpm --filter web dev:electron\"",
    "dev:server": "pnpm --filter server start:dev",
    "dev:web": "pnpm --filter web dev",
    "dev:electron": "pnpm --filter web dev:electron",
    "build": "pnpm --parallel build:server build:web",
    "build:server": "pnpm --filter server build",
    "build:web": "pnpm --filter web build",
    "build:electron": "pnpm run build:server && pnpm --filter web build",
    "build:electron:win": "pnpm run build:electron && node scripts/prepare-native-deps.js && pnpm -C apps/web exec electron-builder --win --publish never",
    "build:web:android": "pnpm run build:web && cd apps/web && npx cap build android",
    "build:apk": "pnpm run build:web:android",
    "test": "jest -c jest.config.ts",
    "test:server": "pnpm --filter server test",
    "test:server:watch": "pnpm --filter server test:watch",
    "test:server:e2e": "pnpm --filter server test:e2e",
    "lint:server": "pnpm --filter server lint",
    "format:server": "pnpm --filter server format",
    "cap:sync:android": "pnpm --filter web exec cap sync android",
    "cap:open:android": "pnpm --filter web exec cap open android",
    "cap:android": "pnpm run build:web && pnpm run cap:sync:android && pnpm run cap:open:android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037",
  "dependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3"
  }
}
